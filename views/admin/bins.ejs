<%- include('../partials/header', { title: 'Bins', extraCss: 'dashboard.css', bodyClass: 'page-dashboard' }) %>
<%- include('../partials/navbar') %>
<div class="layout">
  <%- include('../partials/sidebar', { role: 'admin' }) %>
  <main class="main-content">
    <%- include('../partials/flash') %>
    <header class="page-head">
      <h1>Bin management</h1>
      <p class="page-head__sub">Filter by ward, zone, or status — trigger collection when needed.</p>
    </header>
    <form method="get" class="filters">
      <label>Ward
        <select name="ward">
          <option value="">All</option>
          <% wards.forEach(function (w) { %>
            <option value="<%= w %>" <%= filters.ward === w ? 'selected' : '' %>><%= w %></option>
          <% }); %>
        </select>
      </label>
      <label>Zone
        <select name="zone">
          <option value="">All</option>
          <% zones.forEach(function (z) { %>
            <option value="<%= z %>" <%= filters.zone === z ? 'selected' : '' %>><%= z %></option>
          <% }); %>
        </select>
      </label>
      <label>Status
        <select name="status">
          <option value="">All</option>
          <% ['empty','filling','full','overflow'].forEach(function (s) { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </label>
      <button type="submit" class="btn btn--primary">Apply</button>
    </form>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Bin ID</th>
            <th>Ward / Zone</th>
            <th>Fill</th>
            <th>Status</th>
            <th>Driver</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% bins.forEach(function (b) { %>
            <tr>
              <td><%= b.binId %></td>
              <td><%= b.location && b.location.ward ? b.location.ward : '—' %> / <%= b.location && b.location.zone ? b.location.zone : '—' %></td>
              <td>
                <div class="progress progress--inline" data-level="<%= b.fillLevel %>">
                  <div class="progress__bar" style="width: <%= b.fillLevel %>%"></div>
                </div>
                <%= b.fillLevel %>%
              </td>
              <td><span class="pill pill--<%= b.status %>"><%= b.status %></span></td>
              <td><%= b.assignedDriver ? b.assignedDriver.name : '—' %></td>
              <td>
                <form action="/admin/bins/<%= b._id %>/collect" method="post">
                  <button type="submit" class="btn btn--small btn--secondary">Trigger collection</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <nav class="pagination">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %>&ward=<%= filters.ward || '' %>&zone=<%= filters.zone || '' %>&status=<%= filters.status || '' %>" class="btn btn--ghost">Previous</a>
      <% } %>
      <span>Page <%= page %> of <%= totalPages %> (<%= total %>)</span>
      <% if (page < totalPages) { %>
        <a href="?page=<%= page + 1 %>&ward=<%= filters.ward || '' %>&zone=<%= filters.zone || '' %>&status=<%= filters.status || '' %>" class="btn btn--ghost">Next</a>
      <% } %>
    </nav>
  </main>
</div>
<%- include('../partials/footer') %>
